APP_ENV=development
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=family_finance
DB_SSLMODE=disable

JWT_SECRET=ganti-dengan-secret-yang-panjang-dan-acak-minimal-32-karakter
JWT_EXPIRY_HOURS=72

CORS_ALLOW_ORIGINS=http://localhost:3000,https://finance.giafn.my.id

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Penyimpanan lampiran: 'local' (disk server) atau 's3'.
# Otomatis: 's3' kalau S3_BUCKET diisi, selain itu 'local'. Bisa dipaksa di sini.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080
MAX_UPLOAD_MB=10

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

APP_URL=http://localhost:3000